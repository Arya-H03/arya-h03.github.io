            <div class="topicContainer">
                <h2 id="world-Highlight">Physics Pipeline</h2>
                <p>
                    The physics system runs in three separate stages each frame.
                    Splitting it this way keeps each stage focused and
                    independently testable. A design decision that paid off
                    significantly during debugging.
                </p>

                <ul class="bulletPointList">
                    <li>
                        <b>Broad Phase Spatial Grid:</b> Checking every object
                        against every other object for collision is impractical
                        at scale, 200 objects would mean 40,000 checks every
                        frame. Instead, the world is divided into a grid of
                        small cells. Objects only need to be checked against
                        others that share the same cell, cutting the number of
                        checks down dramatically.
                    </li>
                    <li>
                        <b>Narrow Phase Precise Contact:</b> The candidates from
                        the broad phase are tested exactly using an AABB
                        collision check. A key detail here: rather than just
                        checking the current frame's overlap, the engine also
                        looks at
                        <span id="world-Highlight"
                            >where each object was last frame</span
                        >
                        to determine the correct push direction. This prevents
                        the jittery, incorrect collisions that occur when
                        objects meet at a corner.
                    </li>
                    <li>
                        <b>Resolution Impulse Response:</b> Confirmed collisions
                        are resolved by applying an impulse, a velocity
                        correction proportional to each object's mass. Static
                        objects (walls, platforms) are given infinite effective
                        mass, so they absorb nothing and never move.
                    </li>
                    <li>
                        <b>Debug Visualiser:</b> The spatial grid can be
                        visualised at runtime cells light up yellow when one
                        object overlaps them, red when two or more do. This was
                        invaluable for verifying the broad phase worked
                        correctly.
                    </li>
                </ul>

                <ul class="visualDemo">
                    <li>
                        <div>
                            <h3 id="world-Highlight">
                                Broad Phase Spatial Grid Filtering
                            </h3>
                            <pre><code class="language-cpp">
// Each entity registers into every grid cell its bounds touch.
// Only entities sharing a cell become collision candidates.

for (size_t i = 0; i &lt; chunk.size; ++i)
{
    CCollider&  col = colliders[i];
    CTransform& tr  = transforms[i];

    // Which cells does this entity's bounding box overlap?
    Vect2&lt;int&gt; topLeft  = ((tr.position + col.offset - col.halfSize) / m_cellSize).Floor();
    Vect2&lt;int&gt; botRight = ((tr.position + col.offset + col.halfSize) / m_cellSize).Ceil();


    for (size_t r = topLeft.y; r &lt; botRight.y; ++r)
    {
        for (size_t c = topLeft.x; c &lt; botRight.x; ++c)
        {
            m_grid[r * m_cellPerRow + c].overlapingEntities.push_back(chunk.entities[i]);
        }
    }
}
</code></pre>
                        </div>
                    </li>
                    <li>
                        <div>
                            <h3 id="world-Highlight">
                                Narrow Phase Collison Confirmation
                            </h3>
                            <pre><code class="language-cpp">
// For each two collision candidate pair (e1,e2)

Vect2f e1Center = e1Transform-&gt;position + e1Collider-&gt;offset;
Vect2f e2Center = e2Transform-&gt;position + e2Collider-&gt;offset;

Vect2f distance = e2Center - e1Center;
Vect2f distanceAbs = distance.Abs();

bool xCollide = distanceAbs.x &lt;= (e1Collider-&gt;halfSize.x + e2Collider-&gt;halfSize.x);
bool yCollide = distanceAbs.y &lt;= (e1Collider-&gt;halfSize.y + e2Collider-&gt;halfSize.y);

// Collision is confirmed
if (xCollide &amp;&amp; yCollide)
{
    Vect2f overlap = (e1Collider-&gt;halfSize + e2Collider-&gt;halfSize) - distanceAbs;
    Vect2f lastFrameE1Center = e1Rb-&gt;previousPosition + e1Collider-&gt;offset;
    Vect2f lastFrameE2Center = e2Rb-&gt;previousPosition + e2Collider-&gt;offset;
    Vect2f lastFrameDistance = lastFrameE2Center - lastFrameE1Center;

    bool lastXCollide = std::abs(lastFrameDistance.x) &lt;= (e1Collider-&gt;halfSize.x + e2Collider-&gt;halfSize.x);
    bool lastYCollide = std::abs(lastFrameDistance.y) &lt;= (e1Collider-&gt;halfSize.y + e2Collider-&gt;halfSize.y);

    Vect2f normal;
    float penetration;

    // Calculate penetration amount and collision normal
    if (lastXCollide &amp;&amp; !lastYCollide)
    {
        normal = (distance.y &lt; 0) ? Vect2f(0, -1) : Vect2f(0, 1);
        penetration = overlap.y;
    }
    else if (!lastXCollide &amp;&amp; lastYCollide)
    {
        normal = (distance.x &lt; 0) ? Vect2f(-1, 0) : Vect2f(1, 0);
        penetration = overlap.x;
    }
    else
    {
        if (overlap.x &lt; overlap.y)
        {
            normal = (distance.x &lt; 0) ? Vect2f(-1, 0) : Vect2f(1, 0);
            penetration = overlap.x;
        }
        else
        {
            normal = (distance.y &lt; 0) ? Vect2f(0, -1) : Vect2f(0, 1);
            penetration = overlap.y;
        }
    }
    m_collisionDataVector.emplace_back(e1, e2, normal, penetration);
}
